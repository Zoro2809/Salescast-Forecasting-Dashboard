<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SalesCast</title>
    <meta name="color-scheme" content="light" />

    <!-- Inter (premium system font) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" crossorigin="anonymous" />

    <!-- Font Awesome 6 Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />

    <style>
        /* ═══════════════════════════════════════════════════
           DESIGN TOKENS - BILLION DOLLAR LIGHT MODE
        ═══════════════════════════════════════════════════ */
        :root {
            color-scheme: light;
            --sidebar-w:       270px;
            
            --bg-color:        #f8fafc;
            --glass-bg:        rgba(255, 255, 255, 0.75);
            --glass-border:    rgba(255, 255, 255, 0.5);
            --card-shadow:     0 20px 40px -10px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04);
            
            --sidebar-hover:   rgba(241, 245, 249, 0.8);
            --sidebar-active:  #4f46e5;
            --sidebar-active-bg: rgba(79, 70, 229, 0.08);
            --sidebar-text:    #64748b;
            --sidebar-muted:   #94a3b8;

            --primary:         #4f46e5;     /* Indigo */
            --primary-light:   #818cf8;
            --success:         #0ea5e9;     /* Ocean Blue for variety */
            --warning:         #f43f5e;     /* Rose instead of amber for a modern feel */

            --text-900:        #0f172a;
            --text-700:        #334155;
            --text-500:        #64748b;
            --text-400:        #94a3b8;

            --radius-sm:       10px;
            --radius-md:       18px;
            --radius-lg:       28px;
            --transition:      all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* ═══════════════════════════════════════════════════
           BASE RESET & AMBIENT BACKGROUND
        ═══════════════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            font-size: 14.5px;
            background: var(--bg-color) !important;
            color: var(--text-700) !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow: hidden;
        }

        /* Soft, elegant ambient background blobs */
        .ambient-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
            background: #f8fafc;
        }
        .ambient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.6;
            animation: float 25s infinite alternate ease-in-out;
        }
        .orb-1 { width: 600px; height: 600px; background: rgba(129, 140, 248, 0.2); top: -150px; left: -100px; }
        .orb-2 { width: 700px; height: 700px; background: rgba(14, 165, 233, 0.15); bottom: -200px; right: 5%; animation-delay: -8s; }
        .orb-3 { width: 500px; height: 500px; background: rgba(244, 63, 94, 0.1); top: 30%; left: 30%; animation-delay: -15s; }

        @@keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(50px, 80px) scale(1.1); }
        }

        /* ═══════════════════════════════════════════════════
           APP SHELL
        ═══════════════════════════════════════════════════ */
        .app-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
            position: relative;
            z-index: 1;
        }

        /* ═══════════════════════════════════════════════════
           SIDEBAR
        ═══════════════════════════════════════════════════ */
        .sidebar {
            flex: 0 0 var(--sidebar-w);
            width: var(--sidebar-w);
            background: var(--glass-bg);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-right: 1px solid rgba(255,255,255,0.8);
            box-shadow: 1px 0 20px rgba(0,0,0,0.02);
            z-index: 10;
        }

        /* Brand area */
        .sb-brand {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 32px 28px 24px;
            flex-shrink: 0;
        }
        .sb-logo-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4f46e5 0%, #0ea5e9 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 8px 16px rgba(79, 70, 229, 0.25);
            position: relative;
        }
        .sb-title {
            color: var(--text-900);
            font-size: 18px;
            font-weight: 800;
            display: block;
            letter-spacing: -0.5px;
        }
        .sb-sub {
            color: var(--primary);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        /* Nav */
        .sb-nav {
            flex: 1;
            padding: 16px 20px;
            overflow-y: auto;
        }
        .sb-nav::-webkit-scrollbar { width: 0; }

        .sb-section {
            color: var(--sidebar-muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            padding: 20px 12px 10px;
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            border-radius: 12px;
            margin: 4px 0;
            transition: var(--transition);
            position: relative;
        }
        .sb-link:hover {
            color: var(--text-900);
            background: var(--sidebar-hover);
            text-decoration: none;
            transform: translateX(4px);
        }
        .sb-link.active {
            color: var(--primary);
            background: var(--sidebar-active-bg);
            box-shadow: inset 0 0 0 1px rgba(79, 70, 229, 0.1);
        }
        
        .sb-icon {
            width: 20px;
            text-align: center;
            font-size: 16px;
            flex-shrink: 0;
            transition: var(--transition);
        }

        .sb-badge {
            background: #fdf2f8;
            color: var(--warning);
            border: 1px solid rgba(244, 63, 94, 0.2);
            font-size: 10px;
            font-weight: 800;
            padding: 4px 8px;
            border-radius: 20px;
            margin-left: auto;
            letter-spacing: 0.5px;
        }

        /* Footer */
        .sb-foot {
            padding: 24px 28px;
            color: var(--sidebar-text);
            font-size: 13px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
            background: rgba(255,255,255,0.5);
            border-top: 1px solid rgba(0,0,0,0.03);
        }
        .sb-foot-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            flex-shrink: 0;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
        }

        /* ═══════════════════════════════════════════════════
           MAIN AREA
        ═══════════════════════════════════════════════════ */
        .main-wrap {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: transparent !important;
        }

        /* Header */
        .main-header {
            padding: 48px 48px 24px;
            flex-shrink: 0;
            position: relative;
            z-index: 5;
        }
        .main-header h1 {
            font-size: 36px;
            font-weight: 900;
            margin: 0 0 12px;
            color: var(--text-900) !important;
            letter-spacing: -1px;
        }
        .main-header p {
            font-size: 16px;
            margin: 0;
            color: var(--text-500) !important;
            font-weight: 400;
            max-width: 700px;
            line-height: 1.6;
        }

        /* Body */
        .main-body {
            flex: 1;
            overflow-y: auto;
            padding: 12px 48px 48px;
            scroll-behavior: smooth;
        }
        .main-body::-webkit-scrollbar { width: 8px; }
        .main-body::-webkit-scrollbar-track { background: transparent; }
        .main-body::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 4px; }
        .main-body::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.2); }

        /* ═══════════════════════════════════════════════════
           SEARCH BAR
        ═══════════════════════════════════════════════════ */
        .search-wrap {
            position: relative;
            max-width: 650px;
            margin-bottom: 40px;
        }
        .search-input {
            width: 100%;
            height: 60px;
            padding: 0 24px 0 60px;
            font-size: 16px;
            font-family: inherit;
            font-weight: 500;
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: var(--radius-lg);
            background: rgba(255,255,255,0.8) !important;
            backdrop-filter: blur(12px);
            outline: none;
            color: var(--text-900) !important;
            transition: var(--transition);
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        }
        .search-input:focus {
            background: #ffffff !important;
            border-color: var(--primary-light);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1), 0 10px 25px rgba(0,0,0,0.05);
        }
        .search-input::placeholder { color: var(--text-400) !important; }
        .search-loup {
            position: absolute;
            left: 24px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-400);
            font-size: 20px;
            pointer-events: none;
            z-index: 1;
            transition: var(--transition);
        }
        .search-input:focus ~ .search-loup { color: var(--primary); }

        /* ═══════════════════════════════════════════════════
           AUTOCOMPLETE DROPDOWN
        ═══════════════════════════════════════════════════ */
        .ac-drop {
            display: none;
            position: fixed;
            background: rgba(255,255,255,0.95) !important;
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: var(--radius-md);
            box-shadow: var(--card-shadow), 0 0 0 1px rgba(0,0,0,0.02);
            z-index: 99999;
            max-height: 400px;
            overflow-y: auto;
            padding: 8px;
        }
        .ac-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            cursor: pointer;
            border-radius: 10px;
            transition: var(--transition);
            gap: 12px;
            color: var(--text-700);
        }
        .ac-item:hover, .ac-item.active { 
            background: #f1f5f9 !important; 
            color: var(--text-900);
            transform: translateX(4px);
        }
        .ac-item mark {
            background: rgba(79, 70, 229, 0.1);
            color: var(--primary);
            border-radius: 4px;
            padding: 0 4px;
            font-weight: 700;
        }
        .ac-name {
            flex: 1;
            font-size: 15px;
            font-weight: 500;
        }
        .ac-price {
            font-size: 13px;
            color: var(--text-500);
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 600;
        }
        .ac-empty {
            padding: 24px;
            color: var(--text-500);
            text-align: center;
        }

        /* ═══════════════════════════════════════════════════
           PRODUCT BAR
        ═══════════════════════════════════════════════════ */
        .prod-bar {
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.03);
            border-radius: var(--radius-lg);
            padding: 24px 32px;
            margin-bottom: 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--card-shadow);
        }
        .prod-name {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-900);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }
        .prod-meta {
            font-size: 14px;
            color: var(--text-500);
            font-weight: 500;
        }

        /* ═══════════════════════════════════════════════════
           GENERIC CARDS
        ═══════════════════════════════════════════════════ */
        .card-box {
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.03);
            border-radius: var(--radius-lg);
            box-shadow: var(--card-shadow);
            transition: var(--transition);
        }
        .card-box:hover {
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.12);
        }
        .card-pad { padding: 32px; }
        .card-sm-head {
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-400);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
        }

        /* ═══════════════════════════════════════════════════
           KPI CARDS
        ═══════════════════════════════════════════════════ */
        .kpi {
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.02);
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: var(--card-shadow);
            transition: var(--transition);
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .kpi::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 6px; height: 100%;
        }
        .kpi:hover { 
            transform: translateY(-5px);
            box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.15);
        }

        .kpi-label {
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 12px;
            color: var(--text-500);
        }
        .kpi-val {
            font-size: 52px;
            font-weight: 900;
            line-height: 1;
            margin-bottom: 8px;
            letter-spacing: -2px;
            font-variant-numeric: tabular-nums;
            color: var(--text-900);
        }
        .kpi-sub { font-size: 14px; color: var(--text-400); font-weight: 500; }

        .kpi.blue::before { background: var(--primary); }
        .kpi.blue .kpi-label { color: var(--primary); }

        .kpi.green::before { background: var(--success); }
        .kpi.green .kpi-label { color: var(--success); }

        .kpi.amber::before { background: var(--warning); }
        .kpi.amber .kpi-label { color: var(--warning); }

        /* ═══════════════════════════════════════════════════
           HISTORY TABLE SECTION
        ═══════════════════════════════════════════════════ */
        .hist-wrap {
            background: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.03);
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-top: 32px;
            box-shadow: var(--card-shadow);
        }
        .hist-head {
            padding: 24px 32px;
            border-bottom: 1px solid rgba(0,0,0,0.04);
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-900);
            background: #ffffff;
            display: flex;
            align-items: center;
        }
        .htable { margin: 0; font-size: 15px; color: var(--text-700); }
        .htable thead th {
            background: #f8fafc !important;
            color: var(--text-500) !important;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid rgba(0,0,0,0.04) !important;
            padding: 16px 32px;
        }
        .htable tbody td {
            padding: 18px 32px;
            border-bottom: 1px solid rgba(0,0,0,0.03) !important;
            color: var(--text-700) !important;
            vertical-align: middle;
            font-variant-numeric: tabular-nums;
            font-weight: 500;
        }
        .htable tbody tr:last-child td { border-bottom: none !important; }
        .htable tbody tr:hover td { background: #f8fafc !important; }

        /* ═══════════════════════════════════════════════════
           BOOTSTRAP OVERRIDES
        ═══════════════════════════════════════════════════ */
        .btn-outline-secondary {
            border-color: rgba(0,0,0,0.1);
            color: var(--text-700);
            font-size: 14px;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            transition: var(--transition);
        }
        .btn-outline-secondary:hover {
            background: #f8fafc;
            border-color: rgba(0,0,0,0.2);
            color: var(--text-900);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transform: translateY(-1px);
        }

        .table-sm thead th {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-400);
            border-bottom: 1px solid rgba(0,0,0,0.05) !important;
            padding-bottom: 12px;
        }
        .table-sm td { 
            font-size: 15px; 
            padding: 12px 0;
            border-bottom-color: rgba(0,0,0,0.03); 
        }

        /* ═══════════════════════════════════════════════════
           RESPONSIVE
        ═══════════════════════════════════════════════════ */
        @@media (max-width: 768px) {
            .sidebar { display: none; }
            .main-body { padding: 24px; }
            .search-wrap { max-width: 100%; }
            .kpi-val { font-size: 40px; }
            .main-header { padding: 32px 24px 24px; }
            .main-header h1 { font-size: 28px; }
            .card-pad { padding: 24px; }
            .hist-head { padding: 20px 24px; }
            .htable thead th, .htable tbody td { padding: 14px 24px; }
        }
    </style>

    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
    <div class="ambient-bg">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
        <div class="ambient-orb orb-3"></div>
    </div>

<div class="app-wrapper">

    <!-- ── Sidebar ──────────────────────────────────────────────── -->
    <aside class="sidebar">
        <div class="sb-brand">
            <div class="sb-logo-wrap">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
                <span class="sb-title">SalesCast</span>
                <span class="sb-sub">Enterprise Edge</span>
            </div>
        </div>

        <nav class="sb-nav">
            <div class="sb-section">Models</div>

            <a href="/Reports/Regression"
               class="sb-link @(ViewData["ActivePage"]?.ToString() == "Regression" ? "active" : "")">
                <span class="sb-icon"><i class="fa-solid fa-chart-bar"></i></span>
                LightGBM Regress
            </a>
            <a href="/Reports/TimeSeries"
               class="sb-link @(ViewData["ActivePage"]?.ToString() == "TimeSeries" ? "active" : "")">
                <span class="sb-icon"><i class="fa-solid fa-chart-line"></i></span>
                SSA Time Series
            </a>
            <a href="/Reports/Ensemble"
               class="sb-link @(ViewData["ActivePage"]?.ToString() == "Ensemble" ? "active" : "")">
                <span class="sb-icon"><i class="fa-solid fa-layer-group"></i></span>
                Ensemble Fusion
                <span class="sb-badge">BEST</span>
            </a>

            <hr class="sb-divider" style="border-top:1px solid rgba(0,0,0,0.05); margin: 16px 0;" />
            <div class="sb-section">Analysis</div>

            <a href="/Reports/Comparison"
               class="sb-link @(ViewData["ActivePage"]?.ToString() == "Comparison" ? "active" : "")">
                <span class="sb-icon"><i class="fa-solid fa-scale-balanced"></i></span>
                Model Comparison
            </a>
        </nav>

        <div class="sb-foot">
            <span class="sb-foot-dot"></span>
            System Online
        </div>
    </aside>

    <!-- ── Main ─────────────────────────────────────────────────── -->
    <div class="main-wrap">
        <div class="main-header">
            <h1>@(ViewData["Title"] ?? "Sales Forecast")</h1>
            @if (ViewData["Subtitle"] != null)
            {
                <p>@ViewData["Subtitle"]</p>
            }
        </div>
        <div class="main-body">
            @RenderBody()
        </div>
    </div>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.plot.ly/plotly-basic-2.27.0.min.js"></script>
<script src="@Url.Content("~/js/forecast.js")"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
