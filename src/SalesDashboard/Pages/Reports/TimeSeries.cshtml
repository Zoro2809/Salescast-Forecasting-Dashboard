@page
@model ImprovedSalesForecast.SalesDashboard.Pages.Reports.TimeSeriesModel
@{
    ViewData["Title"] = "SSA Time Series Forecast";
    ViewData["Subtitle"] = "Single Spectrum Analysis — 3-month horizon with 95% confidence intervals. Trained on the top 50 products by total sales.";
    ViewData["ActivePage"] = "TimeSeries";
}

<div class="search-wrap">
    <span class="search-loup">&#x1F50D;</span>
    <input id="searchInput" type="text" class="search-input"
           placeholder="Type a product name (e.g. candle, mug, bag)..." autocomplete="off" />
</div>

<div id="forecastSection" style="display:none;">

    <div class="prod-bar">
        <div>
            <div class="prod-name" id="productTitle"></div>
            <div class="prod-meta" id="productMeta"></div>
        </div>
        <button class="btn btn-sm btn-outline-secondary" onclick="clearProduct()">&#x2715; New Search</button>
    </div>

    <div class="row g-3 mb-0">
        <div class="col-lg-8">
            <div class="card-box card-pad">
                <div id="historyChart" style="height:300px;"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-box card-pad" style="height:100%;">
                <div class="card-sm-head">3-Month Forecast</div>
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Forecast</th>
                            <th>95% CI</th>
                        </tr>
                    </thead>
                    <tbody id="tsForecastBody"></tbody>
                </table>
                <p id="noSsaMsg" class="text-muted small mt-3" style="display:none;">
                    No SSA model for this product. Only the top 50 products by volume have time-series models trained.
                </p>
            </div>
        </div>
    </div>

    <div class="hist-wrap">
        <div class="hist-head">Sales History</div>
        <div class="table-responsive">
            <table class="htable table">
                <thead>
                    <tr><th>Year</th><th>Month</th><th>Units</th><th>Avg/Day</th><th>Max/Day</th><th>Price</th></tr>
                </thead>
                <tbody id="historyBody"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    initSearch('searchInput', function(p) {
        loadForecast(p.id, p.description, p.unitPrice, p.monthCount);
    });

    function loadForecast(productId, description, price, months) {
        document.getElementById('forecastSection').style.display = '';
        document.getElementById('productTitle').textContent = description;
        document.getElementById('productMeta').textContent =
            '£' + (price != null ? price.toFixed(2) : '0.00') + ' per unit · ' + months + ' months of history';

        fetch('/api/catalog/' + productId + '/history')
            .then(function(r) {
                if (!r.ok) throw new Error('History ' + r.status);
                return r.json();
            })
            .then(function(history) {
                populateHistoryTable(history);

                fetch('/api/forecast/' + productId + '/timeseries')
                    .then(function(r) { return r.ok ? r.json() : null; })
                    .then(function(forecast) {
                        var tbody = document.getElementById('tsForecastBody');
                        var noMsg = document.getElementById('noSsaMsg');
                        tbody.innerHTML = '';

                        if (!forecast || !forecast.forecastedUnits || !forecast.forecastedUnits.length) {
                            noMsg.style.display = '';
                            renderHistoryChart(history, null, '', '#0ea5e9');
                            return;
                        }
                        noMsg.style.display = 'none';
                        renderHistoryChart(history, forecast.forecastedUnits[0], 'SSA Forecast', '#0ea5e9');

                        var last = history[history.length - 1];
                        forecast.forecastedUnits.forEach(function(v, i) {
                            var d = new Date(last.year, last.month + i);
                            var lo = Math.max(0, forecast.confidenceLowerBound[i]);
                            var hi = forecast.confidenceUpperBound[i];
                            var tr = document.createElement('tr');
                            tr.innerHTML = '<td>' + d.toLocaleString('default', {month:'short', year:'numeric'}) + '</td>' +
                                '<td><strong style="color:#0ea5e9">' + Math.round(v).toLocaleString() + '</strong></td>' +
                                '<td class="text-muted small">' + Math.round(lo).toLocaleString() + '–' + Math.round(hi).toLocaleString() + '</td>';
                            tbody.appendChild(tr);
                        });
                    })
                    .catch(function(err) {
                        console.error('SSA error:', err);
                        renderHistoryChart(history, null, '', '#10b981');
                        document.getElementById('noSsaMsg').style.display = '';
                    });
            })
            .catch(function(err) { console.error('History error:', err); });
    }

    function clearProduct() {
        document.getElementById('forecastSection').style.display = 'none';
        document.getElementById('searchInput').value = '';
        document.getElementById('searchInput').focus();
    }
</script>
}
