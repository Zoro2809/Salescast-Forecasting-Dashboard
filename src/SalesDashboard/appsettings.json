{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ImprovedSalesDashboard;Trusted_Connection=True;TrustServerCertificate=True;Connection Timeout=60;"
  },
  "MLModels": {
    "RegressionModelPath": "Forecast/ModelFiles/lightgbm_regression.zip",
    "SsaModelFolder": "Forecast/ModelFiles/ssa",
    "SsaModelPathFormat": "Forecast/ModelFiles/ssa/product{0}_ssa.zip"
  },
  "EnsembleWeights": {
    "Regression": 0.6,
    "TimeSeries": 0.4
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
